<?xml version="1.0" ?>
<sdf version="1.5">
    <!-- 12m x 12m navigation terrain: pillar alley + corner obstacles. -->
    <world name="navigation_terrain">

        <physics type="ode">
            <max_step_size>0.0005</max_step_size>
            <real_time_factor>1</real_time_factor>
            <real_time_update_rate>2000</real_time_update_rate>
            <gravity>0 0 -9.81</gravity>
            <ode>
                <solver>
                    <type>quick</type>
                    <iters>50</iters>
                    <sor>1.3</sor>
                </solver>
                <constraints>
                    <cfm>0.0</cfm>
                    <erp>0.2</erp>
                    <contact_max_correcting_vel>10.0</contact_max_correcting_vel>
                    <contact_surface_layer>0.001</contact_surface_layer>
                </constraints>
            </ode>
        </physics>

        <scene>
            <sky>
                <clouds>
                    <speed>12</speed>
                </clouds>
            </sky>
        </scene>

        <!-- A global light source -->
        <include>
            <uri>model://sun</uri>
        </include>

        <!-- A ground plane -->
        <include>
            <uri>model://ground_plane</uri>
        </include>

        <model name="static_environment">
            <static>true</static>

            <!-- Outer boundary (12m x 12m) -->
            <link name="wall_outer_x_pos">
                <pose>6.0 0.0 0.5 0 0 0</pose>
                <collision name="col"><geometry><box><size>0.20 12.40 1.00</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>0.20 12.40 1.00</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
            </link>
            <link name="wall_outer_x_neg">
                <pose>-6.0 0.0 0.5 0 0 0</pose>
                <collision name="col"><geometry><box><size>0.20 12.40 1.00</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>0.20 12.40 1.00</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
            </link>
            <link name="wall_outer_y_pos">
                <pose>0.0 6.0 0.5 0 0 0</pose>
                <collision name="col"><geometry><box><size>12.40 0.20 1.00</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>12.40 0.20 1.00</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
            </link>
            <link name="wall_outer_y_neg">
                <pose>0.0 -6.0 0.5 0 0 0</pose>
                <collision name="col"><geometry><box><size>12.40 0.20 1.00</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>12.40 0.20 1.00</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
            </link>

            <!-- Pillar alley: two rows of cylinders forming a corridor. -->
            <!-- Pillars: radius 0.20m, height 1.00m -->
            <link name="pillar_01">
                <pose>-5.0 -1.2 0.5 0 0 0</pose>
                <collision name="col"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry></collision>
                <visual name="vis"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
            </link>
            <link name="pillar_02">
                <pose>-5.0 1.2 0.5 0 0 0</pose>
                <collision name="col"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry></collision>
                <visual name="vis"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
            </link>
            <link name="pillar_03">
                <pose>-3.8 -1.0 0.5 0 0 0</pose>
                <collision name="col"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry></collision>
                <visual name="vis"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
            </link>
            <link name="pillar_04">
                <pose>-3.8 1.0 0.5 0 0 0</pose>
                <collision name="col"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry></collision>
                <visual name="vis"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
            </link>
            <link name="pillar_05">
                <pose>-2.6 -1.3 0.5 0 0 0</pose>
                <collision name="col"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry></collision>
                <visual name="vis"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
            </link>
            <link name="pillar_06">
                <pose>-2.6 1.3 0.5 0 0 0</pose>
                <collision name="col"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry></collision>
                <visual name="vis"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
            </link>
            <link name="pillar_07">
                <pose>-1.4 -1.0 0.5 0 0 0</pose>
                <collision name="col"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry></collision>
                <visual name="vis"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
            </link>
            <link name="pillar_08">
                <pose>-1.4 1.0 0.5 0 0 0</pose>
                <collision name="col"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry></collision>
                <visual name="vis"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
            </link>
            <link name="pillar_09">
                <pose>-0.2 -1.25 0.5 0 0 0</pose>
                <collision name="col"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry></collision>
                <visual name="vis"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
            </link>
            <link name="pillar_10">
                <pose>-0.2 1.25 0.5 0 0 0</pose>
                <collision name="col"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry></collision>
                <visual name="vis"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
            </link>
            <link name="pillar_11">
                <pose>1.0 -1.0 0.5 0 0 0</pose>
                <collision name="col"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry></collision>
                <visual name="vis"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
            </link>
            <link name="pillar_12">
                <pose>1.0 1.0 0.5 0 0 0</pose>
                <collision name="col"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry></collision>
                <visual name="vis"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
            </link>
            <link name="pillar_13">
                <pose>2.2 -1.2 0.5 0 0 0</pose>
                <collision name="col"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry></collision>
                <visual name="vis"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
            </link>
            <link name="pillar_14">
                <pose>2.2 1.2 0.5 0 0 0</pose>
                <collision name="col"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry></collision>
                <visual name="vis"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
            </link>
            <link name="pillar_15">
                <pose>3.4 -1.0 0.5 0 0 0</pose>
                <collision name="col"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry></collision>
                <visual name="vis"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
            </link>
            <link name="pillar_16">
                <pose>3.4 1.0 0.5 0 0 0</pose>
                <collision name="col"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry></collision>
                <visual name="vis"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
            </link>
            <link name="pillar_17">
                <pose>4.6 -1.3 0.5 0 0 0</pose>
                <collision name="col"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry></collision>
                <visual name="vis"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
            </link>
            <link name="pillar_18">
                <pose>4.6 1.3 0.5 0 0 0</pose>
                <collision name="col"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry></collision>
                <visual name="vis"><geometry><cylinder><radius>0.20</radius><length>1.00</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
            </link>

            <!-- Corner obstacles: two L-shaped corridors built from box walls. -->
            <link name="corner_wall_1">
                <pose>0.0 3.0 0.5 0 0 0</pose>
                <collision name="col"><geometry><box><size>8.00 0.20 1.00</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>8.00 0.20 1.00</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual>
            </link>
            <link name="corner_wall_2">
                <pose>4.0 0.0 0.5 0 0 0</pose>
                <collision name="col"><geometry><box><size>0.20 6.00 1.00</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>0.20 6.00 1.00</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual>
            </link>
            <link name="corner_wall_3">
                <pose>-1.0 -3.0 0.5 0 0 0</pose>
                <collision name="col"><geometry><box><size>10.00 0.20 1.00</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>10.00 0.20 1.00</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual>
            </link>
            <link name="corner_wall_4">
                <pose>-5.0 -1.0 0.5 0 0 0</pose>
                <collision name="col"><geometry><box><size>0.20 4.00 1.00</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>0.20 4.00 1.00</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual>
            </link>

            <!-- A few "random" standalone blocks -->
            <link name="block_1">
                <pose>-2.5 4.5 0.3 0 0 0</pose>
                <collision name="col"><geometry><box><size>0.80 0.80 0.60</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>0.80 0.80 0.60</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual>
            </link>
            <link name="block_2">
                <pose>1.8 4.6 0.3 0 0 0</pose>
                <collision name="col"><geometry><box><size>1.00 0.60 0.60</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>1.00 0.60 0.60</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual>
            </link>
            <link name="block_3">
                <pose>5.0 -4.5 0.3 0 0 0</pose>
                <collision name="col"><geometry><box><size>0.90 0.90 0.60</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>0.90 0.90 0.60</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual>
            </link>
        </model>
    </world>
</sdf>

