<?xml version="1.0" ?>
<sdf version="1.5">
    <!-- 12m x 12m maze terrain (centered at origin). -->
    <world name="maze_terrain">

        <physics type="ode">
            <max_step_size>0.0005</max_step_size>
            <real_time_factor>1</real_time_factor>
            <real_time_update_rate>2000</real_time_update_rate>
            <gravity>0 0 -9.81</gravity>
            <ode>
                <solver>
                    <type>quick</type>
                    <iters>50</iters>
                    <sor>1.3</sor>
                </solver>
                <constraints>
                    <cfm>0.0</cfm>
                    <erp>0.2</erp>
                    <contact_max_correcting_vel>10.0</contact_max_correcting_vel>
                    <contact_surface_layer>0.001</contact_surface_layer>
                </constraints>
            </ode>
        </physics>

        <scene>
            <sky>
                <clouds>
                    <speed>12</speed>
                </clouds>
            </sky>
        </scene>

        <!-- A global light source -->
        <include>
            <uri>model://sun</uri>
        </include>

        <!-- A ground plane -->
        <include>
            <uri>model://ground_plane</uri>
        </include>

        <!-- Maze walls (static). Coordinates: x forward, y left. -->
        <model name="static_environment">
            <static>true</static>

            <!-- Common wall parameters (informational):
                 - thickness: 0.20m
                 - height:    1.00m
                 - terrain size: 12m x 12m (x,y in [-6, 6])
            -->

            <!-- Outer boundary -->
            <link name="wall_outer_x_pos">
                <pose>6.0 0.0 0.5 0 0 0</pose>
                <collision name="col">
                    <geometry><box><size>0.20 12.40 1.00</size></box></geometry>
                </collision>
                <visual name="vis">
                    <geometry><box><size>0.20 12.40 1.00</size></box></geometry>
                    <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
                </visual>
            </link>
            <link name="wall_outer_x_neg">
                <pose>-6.0 0.0 0.5 0 0 0</pose>
                <collision name="col">
                    <geometry><box><size>0.20 12.40 1.00</size></box></geometry>
                </collision>
                <visual name="vis">
                    <geometry><box><size>0.20 12.40 1.00</size></box></geometry>
                    <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
                </visual>
            </link>
            <link name="wall_outer_y_pos">
                <pose>0.0 6.0 0.5 0 0 0</pose>
                <collision name="col">
                    <geometry><box><size>12.40 0.20 1.00</size></box></geometry>
                </collision>
                <visual name="vis">
                    <geometry><box><size>12.40 0.20 1.00</size></box></geometry>
                    <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
                </visual>
            </link>
            <link name="wall_outer_y_neg">
                <pose>0.0 -6.0 0.5 0 0 0</pose>
                <collision name="col">
                    <geometry><box><size>12.40 0.20 1.00</size></box></geometry>
                </collision>
                <visual name="vis">
                    <geometry><box><size>12.40 0.20 1.00</size></box></geometry>
                    <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
                </visual>
            </link>

            <!-- Interior maze (hand-crafted). Corridor width ~1.2m. -->
            <!-- Vertical segments -->
            <link name="wall_v_1">
                <pose>-4.0 -2.5 0.5 0 0 0</pose>
                <collision name="col"><geometry><box><size>0.20 7.00 1.00</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>0.20 7.00 1.00</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material></visual>
            </link>
            <link name="wall_v_2">
                <pose>-2.0 2.5 0.5 0 0 0</pose>
                <collision name="col"><geometry><box><size>0.20 7.00 1.00</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>0.20 7.00 1.00</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material></visual>
            </link>
            <link name="wall_v_3">
                <pose>0.0 -1.0 0.5 0 0 0</pose>
                <collision name="col"><geometry><box><size>0.20 6.00 1.00</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>0.20 6.00 1.00</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material></visual>
            </link>
            <link name="wall_v_4">
                <pose>2.0 1.0 0.5 0 0 0</pose>
                <collision name="col"><geometry><box><size>0.20 6.00 1.00</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>0.20 6.00 1.00</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material></visual>
            </link>
            <link name="wall_v_5">
                <pose>4.0 -2.0 0.5 0 0 0</pose>
                <collision name="col"><geometry><box><size>0.20 6.50 1.00</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>0.20 6.50 1.00</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material></visual>
            </link>

            <!-- Horizontal segments -->
            <link name="wall_h_1">
                <pose>-3.0 4.0 0.5 0 0 0</pose>
                <collision name="col"><geometry><box><size>6.00 0.20 1.00</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>6.00 0.20 1.00</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual>
            </link>
            <link name="wall_h_2">
                <pose>1.0 2.0 0.5 0 0 0</pose>
                <collision name="col"><geometry><box><size>6.00 0.20 1.00</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>6.00 0.20 1.00</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual>
            </link>
            <link name="wall_h_3">
                <pose>-1.0 0.0 0.5 0 0 0</pose>
                <collision name="col"><geometry><box><size>6.00 0.20 1.00</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>6.00 0.20 1.00</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual>
            </link>
            <link name="wall_h_4">
                <pose>3.0 -2.0 0.5 0 0 0</pose>
                <collision name="col"><geometry><box><size>6.00 0.20 1.00</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>6.00 0.20 1.00</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual>
            </link>
            <link name="wall_h_5">
                <pose>-2.0 -4.0 0.5 0 0 0</pose>
                <collision name="col"><geometry><box><size>7.50 0.20 1.00</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>7.50 0.20 1.00</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual>
            </link>
        </model>
    </world>
</sdf>

