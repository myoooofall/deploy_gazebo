<?xml version="1.0" ?>
<sdf version="1.5">
    <world name="platforms">
        <physics type="ode">
            <max_step_size>0.0005</max_step_size>
            <real_time_factor>1</real_time_factor>
            <real_time_update_rate>2000</real_time_update_rate>
            <gravity>0 0 -9.81</gravity>
            <ode>
                <solver>
                    <type>quick</type>
                    <iters>50</iters>
                    <sor>1.3</sor>
                </solver>
                <constraints>
                    <cfm>0.0</cfm>
                    <erp>0.2</erp>
                    <contact_max_correcting_vel>10.0</contact_max_correcting_vel>
                    <contact_surface_layer>0.001</contact_surface_layer>
                </constraints>
            </ode>
        </physics>

        <scene>
            <sky>
                <clouds>
                    <speed>12</speed>
                </clouds>
            </sky>
        </scene>

        <!-- A global light source -->
        <include>
            <uri>model://sun</uri>
        </include>

        <!-- A ground plane -->
        <include>
            <uri>model://ground_plane</uri>
        </include>

        <!-- Two platforms in front of the robot -->
        <!-- Platform 1: 2m long (x), 4m wide (y), 0.4m high (z) -->
        <!-- Position: center at x=3.0m (front edge at x=2.0m from robot at origin) -->
        <model name="platform_1">
            <static>true</static>
            <link name="platform_1_link">
                <pose>3.0 0 0.2 0 0 0</pose>
                <collision name="platform_1_collision">
                    <geometry>
                        <box>
                            <size>2.0 4.0 0.4</size>
                        </box>
                    </geometry>
                    <surface>
                        <friction>
                            <ode>
                                <mu>1.0</mu>
                                <mu2>1.0</mu2>
                                <slip1>0.0</slip1>
                                <slip2>0.0</slip2>
                            </ode>
                        </friction>
                        <bounce>
                            <restitution_coefficient>0.0</restitution_coefficient>
                            <threshold>100000.0</threshold>
                        </bounce>
                        <contact>
                            <ode>
                                <soft_cfm>0.0</soft_cfm>
                                <soft_erp>0.2</soft_erp>
                                <kp>1e12</kp>
                                <kd>1</kd>
                                <max_vel>0.01</max_vel>
                                <min_depth>0.001</min_depth>
                            </ode>
                        </contact>
                    </surface>
                </collision>
                <visual name="platform_1_visual">
                    <geometry>
                        <box>
                            <size>2.0 4.0 0.4</size>
                        </box>
                    </geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/Grey</name>
                        </script>
                        <ambient>0.8 0.8 0.8 1</ambient>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Platform 2: Same size as platform 1 -->
        <!-- Position: center at x=5.3m (0.3m gap between platforms: 4.0+0.3+1.0=5.3) -->
        <model name="platform_2">
            <static>true</static>
            <link name="platform_2_link">
                <pose>5.3 0 0.2 0 0 0</pose>
                <collision name="platform_2_collision">
                    <geometry>
                        <box>
                            <size>2.0 4.0 0.4</size>
                        </box>
                    </geometry>
                    <surface>
                        <friction>
                            <ode>
                                <mu>1.0</mu>
                                <mu2>1.0</mu2>
                                <slip1>0.0</slip1>
                                <slip2>0.0</slip2>
                            </ode>
                        </friction>
                        <bounce>
                            <restitution_coefficient>0.0</restitution_coefficient>
                            <threshold>100000.0</threshold>
                        </bounce>
                        <contact>
                            <ode>
                                <soft_cfm>0.0</soft_cfm>
                                <soft_erp>0.2</soft_erp>
                                <kp>1e12</kp>
                                <kd>1</kd>
                                <max_vel>0.01</max_vel>
                                <min_depth>0.001</min_depth>
                            </ode>
                        </contact>
                    </surface>
                </collision>
                <visual name="platform_2_visual">
                    <geometry>
                        <box>
                            <size>2.0 4.0 0.4</size>
                        </box>
                    </geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/Grey</name>
                        </script>
                        <ambient>0.8 0.8 0.8 1</ambient>
                    </material>
                </visual>
            </link>
        </model>

    </world>
</sdf>

