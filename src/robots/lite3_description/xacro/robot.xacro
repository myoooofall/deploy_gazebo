<?xml version="1.0"?>

<robot name="lite3" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find lite3_description)/urdf/lite3.urdf"/>
    <xacro:include filename="$(find lite3_description)/xacro/gazebo.xacro"/>
    <!-- D34i相机 -->   
    <xacro:include filename="$(find lite3_description)/xacro/_d435i.urdf.xacro"/>
    <xacro:sensor_d435i parent="TORSO" name="camera" topics_ns="camera">
        <origin  xyz="0.345 0 0.07" rpy="0 0.25 0"/>
    </xacro:sensor_d435i>
</robot>
