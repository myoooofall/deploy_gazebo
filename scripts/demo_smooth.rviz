Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.45
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 10
      Frames:
        All Enabled: false
        base_link_smooth:
          Value: true
        map:
          Value: true
      Marker Scale: 3.0
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: OccupancyMap
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_updates
      Use Timestamp: false
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 230; 80
      Enabled: true
      Line Style: Billboards
      Line Width: 0.3
      Name: SmoothPath
      Offset:
        X: 0
        Y: 0
        Z: 0.05
      Pose Color: 255; 255; 255
      Pose Style: None
      Radius: 0.2
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odom_path_smooth
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: DemoMarkers
      Namespaces:
        demo_goal: true
        demo_start: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /demo_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: GoalPredMarkers
      Namespaces:
        goal_pred: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pred_markers
      Value: false
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 155; 0
      Enabled: false
      Line Style: Billboards
      Line Width: 0.18
      Name: GoalPredPath
      Offset:
        X: 0
        Y: 0
        Z: 0.08
      Pose Color: 255; 180; 0
      Pose Style: None
      Radius: 0.08
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pred_path_smooth
      Value: false
    - Alpha: 1
      Class: rviz_default_plugins/Odometry
      Color: 80; 180; 255
      Enabled: false
      Head Length: 0.55
      Head Radius: 0.18
      Keep: 1
      Name: SmoothOdom
      Position Tolerance: 0.01
      Shaft Length: 0.9
      Shaft Radius: 0.08
      Shape: Arrow
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odom_smooth
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 16
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.0
      Yaw: 0.8
      Name: Current View
      Near Clip Distance: 0.01
      Target Frame: map
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1600
